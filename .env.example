# Copy to .env  (never commit .env).  Change every "change_me" value.

# --- what the Next.js app connects as: the restricted role pb_app.
#     It has NO table privileges itself; per request it does SET LOCAL ROLE pb_student / pb_admin / pb_auth.
DATABASE_URL=postgresql://pb_app:app_change_me@localhost:5432/peerbridge
APP_DB_PASSWORD=app_change_me

# --- schema owner (superuser of the Docker database). Used ONLY by docker-compose and `npm run seed`.
OWNER_DATABASE_URL=postgresql://peerbridge:owner_change_me@localhost:5432/peerbridge
DB_OWNER_PASSWORD=owner_change_me

# --- auth + embeddings
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
