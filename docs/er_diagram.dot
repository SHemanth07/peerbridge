  SESSION__created_at [shape=ellipse, style=solid, label="created_at", width=0.5, height=0.35];
  SESSION -- SESSION__created_at [len=1.15];
  SESSION__completed_at [shape=ellipse, style=solid, label="completed_at", width=0.5, height=0.35];
  SESSION -- SESSION__completed_at [len=1.15];
