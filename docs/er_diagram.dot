  HELPS -- USER [len=2.0, color="#000000", headlabel="1", labeldistance=2.2, labelangle=-25, labelfontsize=15, labelfontname="DejaVu Sans Bold", xlabel=<<i>helper</i>>];
  HELPS -- SESSION [len=2.0, color="#000000:#ffffff:#000000", headlabel="N", labeldistance=2.2, labelangle=25, labelfontsize=15, labelfontname="DejaVu Sans Bold"];
  RECEIVES_HELP [shape=diamond, style=filled, fillcolor="#d9eef0", fontsize=11, fontname="DejaVu Sans Bold", penwidth=1.6];
  RECEIVES_HELP -- USER [len=2.0, color="#000000", headlabel="1", labeldistance=2.2, labelangle=-25, labelfontsize=15, labelfontname="DejaVu Sans Bold", xlabel=<<i>asker</i>>];
  RECEIVES_HELP -- SESSION [len=2.0, color="#000000:#ffffff:#000000", headlabel="N", labeldistance=2.2, labelangle=25, labelfontsize=15, labelfontname="DejaVu Sans Bold"];
}
