  DOUBT__title [shape=ellipse, style=solid, label="title", width=0.5, height=0.35];
  DOUBT -- DOUBT__title [len=1.15];
  DOUBT__body [shape=ellipse, style=solid, label="body", width=0.5, height=0.35];
  DOUBT -- DOUBT__body [len=1.15];
  DOUBT__status [shape=ellipse, style=solid, label="status", width=0.5, height=0.35];
  DOUBT -- DOUBT__status [len=1.15];
  DOUBT__embedding [shape=ellipse, style=solid, label="embedding", width=0.5, height=0.35];
  DOUBT -- DOUBT__embedding [len=1.15];
  DOUBT__search_tsv [shape=ellipse, style=dashed, label="search_tsv", width=0.5, height=0.35];
  DOUBT -- DOUBT__search_tsv [len=1.15];
  DOUBT__created_at [shape=ellipse, style=solid, label="created_at", width=0.5, height=0.35];
  DOUBT -- DOUBT__created_at [len=1.15];
  AVAILABILITY_SLOT [shape=box, style=filled, fillcolor="#d9d9d9", fontsize=15, fontname="DejaVu Sans Bold", penwidth=1.8, margin="0.25,0.14"];
