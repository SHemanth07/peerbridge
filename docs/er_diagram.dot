  AVAILABILITY_SLOT__start_time [shape=ellipse, style=solid, label="start_time", width=0.5, height=0.35];
  AVAILABILITY_SLOT -- AVAILABILITY_SLOT__start_time [len=1.15];
  AVAILABILITY_SLOT__end_time [shape=ellipse, style=solid, label="end_time", width=0.5, height=0.35];
  AVAILABILITY_SLOT -- AVAILABILITY_SLOT__end_time [len=1.15];
  AVAILABILITY_SLOT__is_booked [shape=ellipse, style=solid, label="is_booked", width=0.5, height=0.35];
  AVAILABILITY_SLOT -- AVAILABILITY_SLOT__is_booked [len=1.15];
  SESSION [shape=box, style=filled, fillcolor="#d9d9d9", fontsize=15, fontname="DejaVu Sans Bold", penwidth=1.8, margin="0.25,0.14"];
  SESSION__session_id [shape=ellipse, style=solid, label=<<u>session_id</u>>, width=0.5, height=0.35];
