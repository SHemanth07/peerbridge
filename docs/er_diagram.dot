  CONCEPT__concept_id [shape=ellipse, style=solid, label=<<u>concept_id</u>>, width=0.5, height=0.35];
  CONCEPT -- CONCEPT__concept_id [len=1.15];
  CONCEPT__name [shape=ellipse, style=solid, label="name", width=0.5, height=0.35];
  CONCEPT -- CONCEPT__name [len=1.15];
  CONCEPT__description [shape=ellipse, style=solid, label="description", width=0.5, height=0.35];
  CONCEPT -- CONCEPT__description [len=1.15];
  CONCEPT__embedding [shape=ellipse, style=solid, label="embedding", width=0.5, height=0.35];
  CONCEPT -- CONCEPT__embedding [len=1.15];
  DOUBT [shape=box, style=filled, fillcolor="#d9d9d9", fontsize=15, fontname="DejaVu Sans Bold", penwidth=1.8, margin="0.25,0.14"];
  DOUBT__doubt_id [shape=ellipse, style=solid, label=<<u>doubt_id</u>>, width=0.5, height=0.35];
