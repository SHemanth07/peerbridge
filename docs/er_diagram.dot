  AUDIT_LOG__action [shape=ellipse, style=solid, label="action", width=0.5, height=0.35];
  AUDIT_LOG -- AUDIT_LOG__action [len=1.15];
  AUDIT_LOG__row_id [shape=ellipse, style=solid, label="row_id", width=0.5, height=0.35];
  AUDIT_LOG -- AUDIT_LOG__row_id [len=1.15];
  AUDIT_LOG__details [shape=ellipse, style=solid, label="details", width=0.5, height=0.35];
  AUDIT_LOG -- AUDIT_LOG__details [len=1.15];
  AUDIT_LOG__changed_at [shape=ellipse, style=solid, label="changed_at", width=0.5, height=0.35];
  AUDIT_LOG -- AUDIT_LOG__changed_at [len=1.15];
  ENROLS [shape=diamond, style=filled, fillcolor="#d9eef0", fontsize=11, fontname="DejaVu Sans Bold", penwidth=1.6];
  ENROLS__academic_term [shape=ellipse, style=solid, label="academic_term", width=0.5, height=0.35];
  ENROLS -- ENROLS__academic_term [len=1.1];
  ENROLS__enrolled_on [shape=ellipse, style=solid, label="enrolled_on", width=0.5, height=0.35];
  ENROLS -- ENROLS__enrolled_on [len=1.1];
  ENROLS -- USER [len=2.0, color="#000000", headlabel="M", labeldistance=2.2, labelangle=-25, labelfontsize=15, labelfontname="DejaVu Sans Bold"];
  ENROLS -- COURSE [len=2.0, color="#000000", headlabel="N", labeldistance=2.2, labelangle=25, labelfontsize=15, labelfontname="DejaVu Sans Bold"];
  CONTAINS [shape=diamond, style=filled, fillcolor="#d9eef0", fontsize=11, fontname="DejaVu Sans Bold", penwidth=1.6];
  CONTAINS -- COURSE [len=2.0, color="#000000", headlabel="1", labeldistance=2.2, labelangle=-25, labelfontsize=15, labelfontname="DejaVu Sans Bold"];
  CONTAINS -- CONCEPT [len=2.0, color="#000000:#ffffff:#000000", headlabel="N", labeldistance=2.2, labelangle=-70, labelfontsize=15, labelfontname="DejaVu Sans Bold"];
  MASTERS [shape=diamond, style=filled, fillcolor="#d9eef0", fontsize=11, fontname="DejaVu Sans Bold", penwidth=1.6];
  MASTERS__score [shape=ellipse, style=solid, label="score", width=0.5, height=0.35];
  MASTERS -- MASTERS__score [len=1.1];
  MASTERS__note [shape=ellipse, style=solid, label="note", width=0.5, height=0.35];
  MASTERS -- MASTERS__note [len=1.1];
  MASTERS__mastered_at [shape=ellipse, style=solid, label="mastered_at", width=0.5, height=0.35];
  MASTERS -- MASTERS__mastered_at [len=1.1];
  MASTERS__embedding [shape=ellipse, style=solid, label="embedding", width=0.5, height=0.35];
  MASTERS -- MASTERS__embedding [len=1.1];
  MASTERS -- USER [len=2.0, color="#000000", headlabel="M", labeldistance=2.2, labelangle=-25, labelfontsize=15, labelfontname="DejaVu Sans Bold"];
  MASTERS -- CONCEPT [len=2.0, color="#000000", headlabel="N", labeldistance=2.2, labelangle=25, labelfontsize=15, labelfontname="DejaVu Sans Bold"];
  PREREQUISITE_OF [shape=diamond, style=filled, fillcolor="#d9eef0", fontsize=11, fontname="DejaVu Sans Bold", penwidth=1.6];
  PREREQUISITE_OF -- CONCEPT [len=3.0, color="#000000", headlabel="M", labeldistance=2.2, labelangle=55, labelfontsize=15, labelfontname="DejaVu Sans Bold", tailport=w, headport=sw, xlabel=<<i>dependent</i>>];
  PREREQUISITE_OF -- CONCEPT [len=3.0, color="#000000", headlabel="N", labeldistance=2.2, labelangle=-55, labelfontsize=15, labelfontname="DejaVu Sans Bold", tailport=e, headport=se, xlabel=<<i>prerequisite</i>>];
  ASKS [shape=diamond, style=filled, fillcolor="#d9eef0", fontsize=11, fontname="DejaVu Sans Bold", penwidth=1.6];
  ASKS -- USER [len=2.0, color="#000000", headlabel="1", labeldistance=2.2, labelangle=-25, labelfontsize=15, labelfontname="DejaVu Sans Bold"];
  ASKS -- DOUBT [len=2.0, color="#000000:#ffffff:#000000", headlabel="N", labeldistance=2.2, labelangle=25, labelfontsize=15, labelfontname="DejaVu Sans Bold"];
  ABOUT [shape=diamond, style=filled, fillcolor="#d9eef0", fontsize=11, fontname="DejaVu Sans Bold", penwidth=1.6];
  ABOUT -- COURSE [len=2.0, color="#000000", headlabel="1", labeldistance=2.2, labelangle=-25, labelfontsize=15, labelfontname="DejaVu Sans Bold"];
  ABOUT -- DOUBT [len=2.0, color="#000000:#ffffff:#000000", headlabel="N", labeldistance=2.2, labelangle=70, labelfontsize=15, labelfontname="DejaVu Sans Bold"];
  TAGGED_WITH [shape=diamond, style=filled, fillcolor="#d9eef0", fontsize=11, fontname="DejaVu Sans Bold", penwidth=1.6];
  TAGGED_WITH -- CONCEPT [len=2.0, color="#000000", headlabel="1", labeldistance=2.2, labelangle=-25, labelfontsize=15, labelfontname="DejaVu Sans Bold"];
  TAGGED_WITH -- DOUBT [len=2.0, color="#000000", headlabel="N", labeldistance=2.2, labelangle=-70, labelfontsize=15, labelfontname="DejaVu Sans Bold"];
  OFFERS [shape=diamond, style=filled, fillcolor="#d9eef0", fontsize=11, fontname="DejaVu Sans Bold", penwidth=1.6];
  OFFERS -- USER [len=2.0, color="#000000", headlabel="1", labeldistance=2.2, labelangle=-25, labelfontsize=15, labelfontname="DejaVu Sans Bold"];
  OFFERS -- AVAILABILITY_SLOT [len=2.0, color="#000000:#ffffff:#000000", headlabel="N", labeldistance=2.2, labelangle=25, labelfontsize=15, labelfontname="DejaVu Sans Bold"];
  RESOLVED_BY [shape=diamond, style=filled, fillcolor="#d9eef0", fontsize=11, fontname="DejaVu Sans Bold", penwidth=1.6];
  RESOLVED_BY -- DOUBT [len=2.0, color="#000000", headlabel="1", labeldistance=2.2, labelangle=-25, labelfontsize=15, labelfontname="DejaVu Sans Bold"];
  RESOLVED_BY -- SESSION [len=2.0, color="#000000:#ffffff:#000000", headlabel="N", labeldistance=2.2, labelangle=25, labelfontsize=15, labelfontname="DejaVu Sans Bold"];
  BOOKED_IN [shape=diamond, style=filled, fillcolor="#d9eef0", fontsize=11, fontname="DejaVu Sans Bold", penwidth=1.6];
  BOOKED_IN -- AVAILABILITY_SLOT [len=2.0, color="#000000", headlabel="1", labeldistance=2.2, labelangle=-25, labelfontsize=15, labelfontname="DejaVu Sans Bold"];
  BOOKED_IN -- SESSION [len=2.0, color="#000000:#ffffff:#000000", headlabel="N", labeldistance=2.2, labelangle=25, labelfontsize=15, labelfontname="DejaVu Sans Bold"];
