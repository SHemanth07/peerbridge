graph ER {
  layout=neato; overlap=prism; overlap_scaling=4; sep="+16"; splines=true; start=1;
  graph [bgcolor=white, pad=0.4, fontname="DejaVu Sans", labelloc=t, fontsize=26, label="PeerBridge - ER diagram (Chen notation)\n"];
  node  [fontname="DejaVu Sans", fontsize=12];
  edge  [fontname="DejaVu Sans", fontsize=13, color="#000000", penwidth=1.2];
  USER [shape=box, style=filled, fillcolor="#d9d9d9", fontsize=15, fontname="DejaVu Sans Bold", penwidth=1.8, margin="0.25,0.14"];
  USER__user_id [shape=ellipse, style=solid, label=<<u>user_id</u>>, width=0.5, height=0.35];
  USER -- USER__user_id [len=1.15];
  USER__email [shape=ellipse, style=solid, label="email", width=0.5, height=0.35];
  USER -- USER__email [len=1.15];
  USER__password_hash [shape=ellipse, style=solid, label="password_hash", width=0.5, height=0.35];
  USER -- USER__password_hash [len=1.15];
  USER__full_name [shape=ellipse, style=solid, label="full_name", width=0.5, height=0.35];
  USER -- USER__full_name [len=1.15];
  USER__role [shape=ellipse, style=solid, label="role", width=0.5, height=0.35];
  USER -- USER__role [len=1.15];
  USER__semester [shape=ellipse, style=solid, label="semester", width=0.5, height=0.35];
  USER -- USER__semester [len=1.15];
  USER__reputation [shape=ellipse, style=dashed, label="reputation", width=0.5, height=0.35];
  USER -- USER__reputation [len=1.15];
  USER__created_at [shape=ellipse, style=solid, label="created_at", width=0.5, height=0.35];
  USER -- USER__created_at [len=1.15];
  COURSE [shape=box, style=filled, fillcolor="#d9d9d9", fontsize=15, fontname="DejaVu Sans Bold", penwidth=1.8, margin="0.25,0.14"];
  COURSE__course_id [shape=ellipse, style=solid, label=<<u>course_id</u>>, width=0.5, height=0.35];
  COURSE -- COURSE__course_id [len=1.15];
  COURSE__code [shape=ellipse, style=solid, label="code", width=0.5, height=0.35];
  COURSE -- COURSE__code [len=1.15];
  COURSE__title [shape=ellipse, style=solid, label="title", width=0.5, height=0.35];
  COURSE -- COURSE__title [len=1.15];
